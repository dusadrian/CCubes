# Ignore everything
*

# But keep source code and headers
!*.c
!*.h
!*.cpp
!*.hpp
!*.md
!Makefile
!LICENSE
!.gitignore

# Keep the reproducibility artifacts used by the paper
!proofs/
!proofs/README.md
!proofs/*.lean
!proofs/*.py
!proofs/lean-toolchain

# Keep the examples directory and all its contents
!examples/
!examples/**

!tests/
!tests/*.c
!tests/*.sh
!tests/fixtures/
!tests/fixtures/*.pla
!tests/fixtures/*.txt

!scripts/
!scripts/pla_helpers.py
!scripts/joint_cover.py
!scripts/recombine_shared_cover.py
!scripts/run_ipc_shared_cover.py

temp/
proofs/
